SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here

# Cloudflare Turnstile (public site key only — secret stays on Supabase Edge Functions)
TURNSTILE_SITE_KEY=your_turnstile_site_key_here
# Must match a hostname on your Turnstile widget allowlist (often your Supabase project URL).
TURNSTILE_BASE_URL=https://your-project-ref.supabase.co/

# Add this URL under Supabase Dashboard → Authentication → URL Configuration → Redirect URLs:
# thriftline://reset-password
