SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here

# Cloudflare Turnstile (public site key only — secret stays on Supabase Edge Functions)
TURNSTILE_SITE_KEY=your_turnstile_site_key_here
# Mobile WebView base URL. On Flutter Web, Turnstile uses the browser origin instead.
# In Cloudflare Turnstile → your widget → Hostname management, allow EVERY origin you use:
#   - localhost (and 127.0.0.1) for `flutter run -d chrome -t lib/main_admin.dart`
#   - your production Admin domain when deployed
# Optional override (mobile / custom WebView host):
TURNSTILE_BASE_URL=https://your-project-ref.supabase.co/

# Add this URL under Supabase Dashboard → Authentication → URL Configuration → Redirect URLs:
# thriftline://reset-password
